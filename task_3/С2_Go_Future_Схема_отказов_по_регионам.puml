@startuml Context_Diagram_With_Payouts
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

SHOW_PERSON_PORTRAIT()

Person(passenger, "Пассажир", "Заказывает, отслеживает и оплачивает поездки")
Person(driver, "Водитель", "Принимает заказы, управляет поездками\nи получает выплаты") 
Container(routing_service, "DNS+GeoIP2+WAF+ServiceMesh", "Nginx", "Геомаршрутизация, файрвол, маршрутизация")

System_Boundary(region_r1, "Регион R1"){
    System_Boundary(r1_az_a, "Зона доступности А")    {
        Container(service_r1_az_a, "GoFuture Служба", "Элемент системы", "Микросервис\Служба")
        ContainerDb(service_db_r1_az_a, "БД Службы", "PostgreSQL", "БД Микросервиса\Службы")
        
        Rel(routing_service, service_r1_az_a, "ОТКАЗ В ЗАПРОСЕ")
        Rel(service_r1_az_a, service_db_r1_az_a, "ОТКАЗ В ЧТЕНИИ\ЗАПИСИ")
        
    }
    
    System_Boundary(r1_az_b, "Зона доступности Б")    {
        Container(service_r1_az_b, "GoFuture Служба", "Элемент системы", "Микросервис\Служба")
        ContainerDb(service_db_r1_az_b, "БД Службы", "PostgreSQL", "БД Микросервиса\Службы")
        
        Rel(routing_service, service_r1_az_b, "ОТКАЗ В ЗАПРОСЕ")
        Rel(service_r1_az_b, service_db_r1_az_b, "Читает\Записывает данные")
   }
   Rel(service_r1_az_a, service_db_r1_az_b, "МАРШРУТИЗАЦИЯ В РЕГИОН Б")
}

System_Boundary(region_r2, "Регион R2"){
    System_Boundary(r2_az_a, "Зона доступности А")    {
        Container(service_r2_az_a, "GoFuture Служба", "Элемент системы", "Микросервис\Служба")
        ContainerDb(service_db_r2_az_a, "БД Службы", "PostgreSQL", "БД Микросервиса\Службы")
        
        Rel(routing_service, service_r2_az_a, "МАРШРУТИЗАЦИЯ В РЕГИОН R2")
        Rel(service_r2_az_a, service_db_r2_az_a, "ОТКАЗ В ЧТЕНИИ\ЗАПИСИ")
        
    }
    
    System_Boundary(r2_az_b, "Зона доступности Б")    {
        Container(service_r2_az_b, "GoFuture Служба", "Элемент системы", "Микросервис\Служба")
        ContainerDb(service_db_r2_az_b, "БД Службы", "PostgreSQL", "БД Микросервиса\Службы")
        
        Rel(routing_service, service_r2_az_b, "МАРШРУТИЗАЦИЯ В РЕГИОН R2")
        Rel(service_r2_az_b, service_db_r2_az_b, "Читает\Записывает данные")
   }
   Rel(service_r2_az_a, service_db_r2_az_b, "МАРШРУТИЗАЦИЯ В РЕГИОН Б")
}

Lay_L(r1_az_a, r1_az_b)

Rel(service_db_r1_az_a, service_db_r1_az_b, "Синхронная репликация")
Rel(service_db_r1_az_b, service_db_r1_az_a, "Синхронная репликация")

Rel(service_db_r2_az_a, service_db_r2_az_b, "Синхронная репликация")
Rel(service_db_r2_az_b, service_db_r2_az_a, "Синхронная репликация")


Rel(service_db_r1_az_a, service_db_r2_az_a, "Асинхронная репликация")
Rel(service_db_r1_az_b, service_db_r2_az_b, "Acинхронная репликация")

Rel(passenger, routing_service, "Направляет запрос")
Rel(driver, routing_service, "Направляет запрос")

@enduml