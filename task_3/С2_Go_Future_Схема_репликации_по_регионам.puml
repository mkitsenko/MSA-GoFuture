        Container(booking_service_r1_az_a, "GoFuture Заказы", "Python Flask", "Сервис Заказов для клиентов")
        Container(driver_service_r1_az_a, "GoFuture Водитель", "Python Flask", "Сервис работы с Водителями")
        Container(pricing_service_r1_az_a, "GoFuture Прайсинг","Python Flask", "Сервис обработки ценообразования")
