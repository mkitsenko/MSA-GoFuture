        Rel(notification_service_r1_az_a, db_notifications_r1_az_a, "Читает\Записывает данные")
        Rel(fraud_service_r1_az_a, db_fraud_r1_az_a, "Читает\Записывает данные")
    }
   
   Lay_D(r1_az_a, r1_az_a)
    
   System_Ext(yandex_pay_r1, "Яндекс.Пэй", "Обрабатывает платежные транзакции")
