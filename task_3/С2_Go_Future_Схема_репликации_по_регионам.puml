        Rel(routing_service_r1_az_a, payment_service_r1_az_a, "Маршрутизирует")
        Rel(routing_service_r1_az_a, geography_service_r1_az_a, "Маршрутизирует")
        Rel(routing_service_r1_az_a, notification_service_r1_az_a, "Маршрутизирует")
        Rel(routing_service_r1_az_a, fraud_service_r1_az_a, "Маршрутизирует")
        
        Rel(booking_service_r1_az_a, db_booking_r1_az_a, "Читает\Записывает данные")
        Rel(driver_service_r1_az_a, db_driver_r1_az_a, "Читает\Записывает данные")
